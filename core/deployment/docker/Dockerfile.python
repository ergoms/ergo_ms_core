# ERGO MS — общий Python-образ (API, media_api, Celery, Jupyter)
# Без # syntax=docker/dockerfile:… — иначе BuildKit тянет frontend с Hub при каждой сборке.
ARG PYTHON_BASE=python:3.12-slim-bookworm
FROM ${PYTHON_BASE} AS base

ARG ERGO_DOCKER_DEPS_CACHE=internal

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUTF8=1 \
    PYTHONPATH=/app \
    POETRY_VERSION=2.1.3 \
    POETRY_VIRTUALENVS_PATH=/app/virtual_env/python \
    POETRY_NO_INTERACTION=1 \
    POETRY_CACHE_DIR=/tmp/poetry-cache \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Повторная сборка от ergo_ms-python:local не ходит в Debian/PyPI, если poetry уже есть.
RUN if command -v poetry >/dev/null 2>&1; then \
      poetry --version; \
    else \
      apt-get update \
      && apt-get install -y --no-install-recommends \
          build-essential \
          curl \
          git \
          libpq-dev \
      && rm -rf /var/lib/apt/lists/* \
      && pip install --no-cache-dir "poetry==${POETRY_VERSION}"; \
    fi

# commands install запускается системным Python до заполнения volume venv.
# Проверка изоляции должна читать YAML уже на этом этапе (версия из poetry.lock).
RUN python -c "import yaml" 2>/dev/null || pip install --no-cache-dir "PyYAML==6.0.3"

WORKDIR /app

# Зависимости lock — отдельный слой (без modules/, чтобы правки кода не сбрасывали кэш)
COPY pyproject.toml poetry.lock ./

RUN mkdir -p core/api core/media_api modules virtual_env/python virtual_env/cache logs media notebooks \
    /usr/local/lib/ergo-ms

RUN sh -c 'if [ "$ERGO_DOCKER_DEPS_CACHE" != "off" ]; then \
      if poetry run python -c "import django" >/dev/null 2>&1; then \
        echo "django ok (cached)"; \
      else \
        poetry install --no-root --only main --no-ansi \
        && poetry run python -c "import django; print(\"django ok\")"; \
      fi; \
    fi'

RUN sh -c 'if [ "$ERGO_DOCKER_DEPS_CACHE" = "off" ]; then \
      poetry install --no-root --only main --no-ansi \
      && poetry run python -c "import django; print(\"django ok\")"; \
    fi'

# Код образа (в dev полный проект — bind-mount; полная установка ядра+модулей — api install при init)
COPY core/api/src ./core/api/src
COPY core/api/commands ./core/api/commands
COPY core/api/scripts ./core/api/scripts
COPY core/media_api/src ./core/media_api/src
COPY core/shared ./core/shared
COPY modules ./modules

# Вне /app — bind-mount проекта на Windows не перезаписывает entrypoint (CRLF)
COPY core/deployment/docker/entrypoint/wait_for_services.py /usr/local/lib/ergo-ms/wait_for_services.py
COPY core/deployment/docker/entrypoint/wait_for_docker_setup.py /usr/local/lib/ergo-ms/wait_for_docker_setup.py
COPY core/deployment/docker/entrypoint/ergoms.sh /usr/local/lib/ergo-ms/ergoms.sh
COPY core/deployment/docker/entrypoint/docker_entrypoint.sh /usr/local/bin/ergo-docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/ergo-docker-entrypoint.sh \
    && sed -i 's/\r$//' /usr/local/lib/ergo-ms/ergoms.sh \
    && cp /usr/local/lib/ergo-ms/ergoms.sh /usr/local/bin/ergoms \
    && chmod +x /usr/local/bin/ergo-docker-entrypoint.sh /usr/local/bin/ergoms

ENV PATH="/app/virtual_env/python/bin:${PATH}"

ENTRYPOINT ["/usr/local/bin/ergo-docker-entrypoint.sh"]

# Воркер кластера: код и venv внутри образа, без bind-mount корня проекта.
# Клиент Docker и библиотеки браузера нужны, чтобы задача на узле могла открыть свой контейнер и окно.
FROM base AS worker
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-xcb1 \
        libxcb-dri3-0 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxkbcommon0 \
        libxrandr2 \
        libxshmfence1 \
    && arch="${TARGETARCH:-amd64}" \
    && case "$arch" in \
         amd64) docker_arch=x86_64 ;; \
         arm64) docker_arch=aarch64 ;; \
         *) docker_arch=x86_64 ;; \
       esac \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${docker_arch}/docker-27.5.1.tgz" \
        | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
    && rm -rf /var/lib/apt/lists/*
COPY core/deployment ./core/deployment
ENV CELERY_CLUSTER=on \
    CELERY_CLUSTER_ROLE=agent
# Ядро ставится из poetry.lock. Эти пакеты живут только в pyproject модулей,
# без них воркер падает на импорте моделей и на задаче парсера.
RUN poetry run pip install --no-cache-dir \
        'pgvector>=0.3.6,<0.4' \
        'aiohttp>=3.13.3,<4' \
        'beautifulsoup4>=4.14.3,<5' \
        'lxml>=6.0.2,<7' \
        'pypdf>=6.14.2,<7' \
        'pdfplumber>=0.11.0,<0.12' \
        'selenium>=4.27.0,<5' \
        'python-docx>=1.2.0,<2' \
        'docxtpl>=0.20.2,<0.21' \
        'openpyxl>=3.1.0,<4' \
        'httpx>=0.28.0,<1' \
        'django-filter>=24.3' \
        'Pillow>=11.0' \
        'psutil>=6.0' \
        'numpy>=2.0' \
        'pandas>=2.2' \
        'scipy>=1.15' \
        'scikit-learn>=1.4' \
        'scikit-image>=0.25' \
        'opencv-python-headless>=4.12,<5' \
        'matplotlib>=3.10' \
        'joblib>=1.4' \
        'pyarrow>=23.0' \
        'networkx>=3.2' \
        'sqlalchemy>=2.0' \
        'pydantic>=2.12' \
        'clickhouse-connect>=0.8.18' \
        'pymssql>=2.3.7' \
        'reportlab>=4.4' \
        'sympy>=1.14' \
        'polars>=1.35' \
        'chonkie>=1.5,<2'
# Chrome for Testing линкуется с cairo. Отдельный слой, чтобы не сбрасывать pip.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcairo2 \
    && rm -rf /var/lib/apt/lists/*
CMD ["python", "core/api/scripts/start_celery_worker.py"]

# Последняя стадия — прежний образ Compose. Сборка без --target её и берёт.
FROM base AS runtime
