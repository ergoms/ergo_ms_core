# ERGO MS — Node-образ для клиента (dev Vite / prod build)
# Без # syntax=docker/dockerfile:… — иначе BuildKit тянет frontend с Hub при каждой сборке.
#
# npm-зависимости не ставятся при сборке образа: в compose проект bind-mount'ится,
# node_modules — в именованных томах (virtual_env/npm/node_modules),
# установка — ensure_npm_deps.sh → npm run install:all
# (тот же сценарий, что ergoms setup-full).
FROM node:20-bookworm-slim

# npm 10.8.x в базовом образе на Docker Desktop (Windows) может зависать на reify;
# 10.9.2+ содержит исправление (npm/cli#7868).
RUN npm install -g npm@10.9.2 \
    && npm config set update-notifier false \
    && npm config set audit false \
    && npm config set fund false

ENV NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

COPY core/deployment/docker/entrypoint/wait_for_docker_setup.sh /usr/local/bin/ergo-wait-docker-setup.sh
RUN sed -i 's/\r$//' /usr/local/bin/ergo-wait-docker-setup.sh \
    && chmod +x /usr/local/bin/ergo-wait-docker-setup.sh

COPY core/deployment/docker/entrypoint/ensure_npm_deps.sh /usr/local/bin/ergo-ensure-npm-deps.sh
RUN sed -i 's/\r$//' /usr/local/bin/ergo-ensure-npm-deps.sh \
    && chmod +x /usr/local/bin/ergo-ensure-npm-deps.sh

CMD ["npm", "run", "dev", "-w", "@ergo-ms/core-client", "--prefix", "virtual_env/npm"]
