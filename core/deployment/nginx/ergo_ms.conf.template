# ERGO MS — reverse proxy и раздача статики (production, один домен).
#
# Установка (Linux):
#   export ERGO_ROOT=/var/www/ergo_ms
#   export ERGO_SERVER_NAME=app.example.com
#   export ERGO_SSL_CERT=/etc/letsencrypt/live/app.example.com/fullchain.pem
#   export ERGO_SSL_KEY=/etc/letsencrypt/live/app.example.com/privkey.pem
#   bash core/deployment/nginx/install.sh
#
# Или: NGINX_USE_HTTPS=true в .env и sudo ergoms install-nginx
#
# Перед запуском:
#   ergoms build-all
#   API_HOST=127.0.0.1, CLIENT_USE_RELATIVE_API=true, MEDIA_API_* — см. core/deployment/nginx/env.example
#
# Upstream-сервисы (ergoms dev / start-media) слушают только localhost.

include ${ERGO_NGINX_SNIPPETS}/http_hardening.conf;
include ${ERGO_NGINX_SNIPPETS}/compression.conf;
include ${ERGO_NGINX_SNIPPETS}/rate_limit.conf;

${ERGO_API_UPSTREAM_BLOCK}

${ERGO_MEDIA_UPSTREAM_BLOCK}

${ERGO_MODULE_UPSTREAMS}
${ERGO_JUPYTER_UPSTREAM}

${ERGO_HOST_POLICY_BLOCKS}
# Редирект HTTP -> HTTPS (закомментируйте блок server :80, если TLS только на балансировщике)
server {
    listen 80;
    listen [::]:80;
    server_name ${ERGO_SERVER_NAME} localhost 127.0.0.1;

    location /.well-known/acme-challenge/ {
        root ${ERGO_TLS_WEBROOT};
    }

    location / {
        return 301 ${ERGO_HTTP_CANONICAL_REDIRECT};
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${ERGO_SERVER_NAME} localhost 127.0.0.1;

    ssl_certificate         ${ERGO_SSL_CERT};
    ssl_certificate_key     ${ERGO_SSL_KEY};
    ssl_trusted_certificate ${ERGO_SSL_CERT};
    include ${ERGO_NGINX_SNIPPETS}/tls_params.conf;

    include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
    include ${ERGO_NGINX_SNIPPETS}/security_headers_hsts.conf;

    # Vue SPA (ergoms client-build -> core/client/dist)
    root ${ERGO_ROOT}/core/client/dist;
    index index.html;

    # Вычисляется из MEDIA_UPLOAD_MAX_SIZE + direct-upload (tasks и др.) + margin
    # (core/deployment/upload_limits.py → ergoms upload-limits-check)
    client_max_body_size ${ERGO_CLIENT_MAX_BODY_SIZE};

    include ${ERGO_NGINX_SNIPPETS}/proxy_params.conf;

${ERGO_MAINTENANCE_SNIPPET}
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Статус режима works для клиента без API (ergoms maintenance-on/off обновляет dist/maintenance.json)
    location = /maintenance.json {
        add_header Cache-Control "no-store" always;
        try_files /maintenance.json =404;
    }

    # --- Vite hashed assets (ergoms client-build -> core/client/dist/assets) ---
    # bootstrap-early — hashed /assets/bootstrap-early-*.js (см. vite bootstrapEarlyAssetPlugin)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # SPA shell не кэшировать: иначе после maintenance/client-build браузер
    # держит старый index (304) и крутит boot-loader без новых /api запросов.
    location = /index.html {
        if ($maintenance = 1) { return 503; }
        add_header Cache-Control "no-store" always;
        include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
    }

    location = / {
        if ($maintenance = 1) { return 503; }
        add_header Cache-Control "no-store" always;
        include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
        try_files /index.html =404;
    }

    # --- Клиент (Vue Router, history mode) ---
    location / {
        if ($maintenance = 1) { return 503; }
        limit_conn ergo_conn 50;
        try_files $uri $uri/ /index.html;
    }

${ERGO_REALTIME_STREAM_LOCATION}
${ERGO_MODULE_LOCATIONS}
${ERGO_HOST_API_WS_PROXY}

    # --- Django collectstatic (ergoms collectstatic -> virtual_env/static_api) ---
    location /static/ {
        alias ${ERGO_ROOT}/virtual_env/static_api/;
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
        access_log off;
    }

${ERGO_HOST_MEDIA_PROXY}

${ERGO_JUPYTER_LOCATION}
}
