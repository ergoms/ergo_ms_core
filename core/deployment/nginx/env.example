# Production .env за nginx (ergoms install-nginx, install-tls).
# Скопируйте нужные значения в корневой .env проекта.
# Redis, Celery, channel layer — блок «Несколько процессов» в корневом .env.example.

# --- Nginx ---

NGINX_ENABLED=true
NGINX_SERVER_NAME=app.example.com
NGINX_PUBLIC_HOST=app.example.com
# allow | redirect | deny — см. корневой .env.example
NGINX_HOST_POLICY=redirect
# NGINX_ALT_HOSTS=
NGINX_LISTEN_PORT=80
NGINX_USE_HTTPS=false
# 127.0.0.1 — dev без LAN; при install-nginx без HTTPS — авто 0.0.0.0, с HTTPS — 127.0.0.1
NGINX_LISTEN_HOST=127.0.0.1

# --- TLS (ergo_ms.conf.template, ergoms install-tls на Linux) ---

ERGO_TLS_EMAIL=admin@example.com
# ERGO_TLS_DOMAINS=app.example.com,www.app.example.com
# ERGO_TLS_WEBROOT=/var/www/certbot
# ERGO_TLS_STAGING=false
ERGO_SSL_CERT=/etc/letsencrypt/live/app.example.com/fullchain.pem
ERGO_SSL_KEY=/etc/letsencrypt/live/app.example.com/privkey.pem

# После install-tls: сверьте с ergoms status-tls / suggest-env
SECURE_SSL_REDIRECT=false
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- API и клиент ---

API_DEPLOY_TYPE=production
CLIENT_DEPLOY_TYPE=production
API_HOST=127.0.0.1
API_PORT=8000
API_ALLOWED_HOSTS=app.example.com
CLIENT_USE_RELATIVE_API=true
FRONTEND_BASE_URL=https://app.example.com
CLIENT_MAINTENANCE_POLL_ENABLED=true

# --- Media API ---

MEDIA_API_URL=https://app.example.com
MEDIA_API_BIND_HOST=127.0.0.1
MEDIA_API_BIND_PORT=8003
MEDIA_API_DEPLOY_TYPE=production
MEDIA_API_ALLOWED_HOSTS=app.example.com
MEDIA_ACCESS_MODE=local
# MEDIA_ACCESS_MODE=remote:
# MEDIA_API_INTERNAL_KEY=<openssl rand -hex 32>
# MEDIA_API_INTERNAL_URL=http://10.0.0.5:8003

# --- Jupyter (опционально, за nginx) ---

# API_JUPYTER_ACCESS_MODE=nginx
# API_JUPYTER_BEHIND_NGINX=true
# API_JUPYTER_BIND_HOST=127.0.0.1
# API_JUPYTER_BIND_PORT=8002
# API_JUPYTER_BASE_PATH=/jupyter/
# API_JUPYTER_TOKEN=<openssl rand -hex 32>
# Доступ: сессия глобального админа в SPA + ?token=... в URL JupyterLab

# --- Realtime (при необходимости) ---

# REALTIME_TRANSPORT=sse
# REALTIME_POLL_PRESENCE_INTERVAL=60
# REALTIME_POLL_NOTIFICATIONS_INTERVAL=30
# REALTIME_POLL_ADMIN_PRESENCE_INTERVAL=30
# REALTIME_POLL_MESSENGER_INTERVAL=10
