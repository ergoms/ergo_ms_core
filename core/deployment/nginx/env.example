# Переменные для core/deployment/nginx и production .env за nginx.
# Скопируйте нужные значения в корневой .env проекта.

# --- корневой .env: nginx-сценарий (ergoms install-nginx) ---
NGINX_ENABLED=true
NGINX_SERVER_NAME=app.example.com
NGINX_LISTEN_PORT=80

# --- SSL (только production Linux, ergo_ms.conf.template) ---
ERGO_SSL_CERT=/etc/letsencrypt/live/app.example.com/fullchain.pem
ERGO_SSL_KEY=/etc/letsencrypt/live/app.example.com/privkey.pem

# --- корневой .env (production) ---
API_DEPLOY_TYPE=production
CLIENT_DEPLOY_TYPE=production

API_HOST=127.0.0.1
API_PORT=8000
API_ALLOWED_HOSTS=app.example.com

VITE_USE_RELATIVE_API=true
FRONTEND_BASE_URL=https://app.example.com

MEDIA_API_HOST=app.example.com
MEDIA_API_PORT=443
MEDIA_API_BIND_PORT=8003
MEDIA_API_PROTOCOL=https
MEDIA_API_DEPLOY_TYPE=production
MEDIA_API_BIND_HOST=127.0.0.1
MEDIA_API_ALLOWED_HOSTS=app.example.com
MEDIA_API_SECURE_SSL_REDIRECT=false
MEDIA_API_HSTS_ENABLED=false
MEDIA_API_HEALTH_PUBLIC=false
MEDIA_API_UPLOAD_RATE=30/minute

SECURE_SSL_REDIRECT=false

CORS_ALLOWED_ORIGINS=https://app.example.com
