# ERGO MS — reverse proxy и раздача статики (HTTP, без SSL).
#
# Используется для локальной разработки и тестирования на Windows/Linux.
# Для production с HTTPS: NGINX_USE_HTTPS=true или ergo_ms.conf.template.
#
# Переменные шаблона:
#   ${ERGO_SERVER_NAME}  — публичный host (IP или hostname)
#   ${ERGO_LISTEN_HOST}  — bind (127.0.0.1 для локального, 0.0.0.0 для LAN)
#   ${ERGO_LISTEN_PORT}  — порт (например, 80 или 8080)
#   ${ERGO_ROOT}        — корень проекта (например, C:/projects/ergo_ms)
#   ${ERGO_NGINX_SNIPPETS} — путь к snippets (proxy_params.conf)
#   ERGO_HOST_POLICY_BLOCKS - блоки redirect/deny (NGINX_HOST_POLICY в .env)

include ${ERGO_NGINX_SNIPPETS}/http_hardening.conf;
include ${ERGO_NGINX_SNIPPETS}/compression.conf;
include ${ERGO_NGINX_SNIPPETS}/rate_limit.conf;

${ERGO_API_UPSTREAM_BLOCK}

${ERGO_MEDIA_UPSTREAM_BLOCK}

${ERGO_JUPYTER_UPSTREAM}

${ERGO_HOST_POLICY_BLOCKS}
server {
    listen ${ERGO_LISTEN_HOST}:${ERGO_LISTEN_PORT};
    # localhost/127.0.0.1 — чтобы открытие с той же машины не упиралось в чужой default server
    server_name ${ERGO_SERVER_NAME} localhost 127.0.0.1;

    include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;

    root ${ERGO_ROOT}/core/client/dist;
    index index.html;

    client_max_body_size 610m;

    include ${ERGO_NGINX_SNIPPETS}/proxy_params.conf;

${ERGO_MAINTENANCE_SNIPPET}
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location /.well-known/acme-challenge/ {
        root ${ERGO_TLS_WEBROOT};
    }

    # Статус режима works для клиента без API (ergoms maintenance-on/off обновляет dist/maintenance.json)
    location = /maintenance.json {
        add_header Cache-Control "no-store" always;
        try_files /maintenance.json =404;
    }

    # --- Vite hashed assets (ergoms client-build -> core/client/dist/assets) ---
    # bootstrap-early — hashed /assets/bootstrap-early-*.js (см. vite bootstrapEarlyAssetPlugin)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # SPA shell не кэшировать: иначе после maintenance/client-build браузер
    # держит старый index (304) и крутит boot-loader без новых /api запросов.
    location = /index.html {
        if ($maintenance = 1) { return 503; }
        add_header Cache-Control "no-store" always;
        include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
    }

    location = / {
        if ($maintenance = 1) { return 503; }
        add_header Cache-Control "no-store" always;
        include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
        try_files /index.html =404;
    }

    # --- Vue SPA (Vue Router, history mode) ---
    location / {
        if ($maintenance = 1) { return 503; }
        limit_conn ergo_conn 50;
        try_files $uri $uri/ /index.html;
    }

${ERGO_REALTIME_STREAM_LOCATION}
${ERGO_MODULE_LOCATIONS}
${ERGO_HOST_API_WS_PROXY}

    # --- Django collectstatic ---
    location /static/ {
        alias ${ERGO_ROOT}/virtual_env/static_api/;
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
        access_log off;
    }

${ERGO_HOST_MEDIA_PROXY}

${ERGO_JUPYTER_LOCATION}
}
