# ERGO MS — reverse proxy и раздача статики (HTTP, без SSL).
#
# Используется для локальной разработки и тестирования на Windows/Linux.
# Для production с HTTPS: NGINX_USE_HTTPS=true или ergo_ms.conf.template.
#
# Переменные шаблона:
#   ${ERGO_SERVER_NAME}  — публичный host (IP или hostname)
#   ${ERGO_LISTEN_HOST}  — bind (127.0.0.1 для локального, 0.0.0.0 для LAN)
#   ${ERGO_LISTEN_PORT}  — порт (например, 80 или 8080)
#   ${ERGO_ROOT}        — корень проекта (например, C:/projects/ergo_ms)
#   ${ERGO_NGINX_SNIPPETS} — путь к snippets (proxy_params.conf)
#   ERGO_HOST_POLICY_BLOCKS - блоки redirect/deny (NGINX_HOST_POLICY в .env)

include ${ERGO_NGINX_SNIPPETS}/http_hardening.conf;
include ${ERGO_NGINX_SNIPPETS}/rate_limit.conf;

upstream ergo_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

upstream ergo_media {
    server 127.0.0.1:8003;
    keepalive 8;
}

${ERGO_HOST_POLICY_BLOCKS}
server {
    listen ${ERGO_LISTEN_HOST}:${ERGO_LISTEN_PORT};
    server_name ${ERGO_SERVER_NAME};

    include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;

    root ${ERGO_ROOT}/core/client/dist;
    index index.html;

    client_max_body_size 110m;

    include ${ERGO_NGINX_SNIPPETS}/proxy_params.conf;

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # --- Vue SPA (Vue Router, history mode) ---
    location / {
        limit_conn ergo_conn 50;
        try_files $uri $uri/ /index.html;
    }

    # --- Django API ---
    location /api/ {
        limit_req zone=ergo_api burst=50 nodelay;
        limit_conn ergo_conn 50;
        proxy_pass http://ergo_api;
    }

    # --- WebSocket ---
    location /ws/ {
        limit_conn ergo_conn 20;
        proxy_pass http://ergo_api;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # --- Django collectstatic ---
    location /static/ {
        alias ${ERGO_ROOT}/virtual_env/static_api/;
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        include ${ERGO_NGINX_SNIPPETS}/security_headers.conf;
        access_log off;
    }

    # --- Media API ---
    location /serve/ {
        limit_req zone=ergo_serve burst=40 nodelay;
        limit_conn ergo_conn 30;
        proxy_pass http://ergo_media;
    }

    location /upload/ {
        limit_req zone=ergo_upload burst=10 nodelay;
        limit_conn ergo_conn 10;
        proxy_pass http://ergo_media;
        client_max_body_size 110m;
    }

    location /health/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        limit_req zone=ergo_api burst=5 nodelay;
        proxy_pass http://ergo_media;
        access_log off;
    }
}
