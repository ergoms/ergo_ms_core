# Версия системы (отображается в API, Swagger и session-bootstrap)
VERSION=2.1.0

# --- API ---

# Хост и порт для API сервера
API_HOST=localhost
API_PORT=8000

# Разрешенные хосты для API (через запятую)
API_ALLOWED_HOSTS=localhost,127.0.0.1

# Тип развертывания API: development (разработка) или production (продакшн)
API_DEPLOY_TYPE=development

# Документация API (Swagger UI / ReDoc):
# true  — доступны /swagger/ и /redoc/
# false — маршруты документации отключены
# По умолчанию: включено в development, выключено в production
API_SWAGGER_ENABLED=true

# HTML-формы Django REST Framework на /api/... (Browsable API):
# true  — в браузере видны интерактивные страницы DRF
# false — только JSON-ответы
# По умолчанию: включено в development, выключено в production
API_DRF_BROWSABLE_ENABLED=true

# JWT Tokens (время жизни в минутах)
# true  — ограничивать срок жизни (используются значения ниже)
# false — срок жизни не ограничивается (значения lifetime игнорируются)
API_JWT_LIFETIME_ENABLED=true
API_ACCESS_TOKEN_LIFETIME=30
API_REFRESH_TOKEN_LIFETIME=60

# Время жизни токенов при "Запомнить меня" (только при API_JWT_LIFETIME_ENABLED=true)
# access = 3 дня, refresh = 7 дней
API_REMEMBER_ME_ACCESS_TOKEN_LIFETIME=4320
API_REMEMBER_ME_REFRESH_TOKEN_LIFETIME=10080

# Отдельный ключ для подписи JWT-токенов (если не задан, используется API_SECRET_KEY)
# Рекомендуется задать уникальный ключ в production
# API_JWT_SIGNING_KEY=your-jwt-signing-key

# Настройки ограничения частоты запросов (rate limiting)
API_THROTTLE_RATES_ANON=100/minute
API_THROTTLE_RATES_USER=6000/hour

# Секретный ключ для Django (используется для криптографии, подписей и т.д.)
API_SECRET_KEY=secret-key

# Пул соединений Django с PostgreSQL/MySQL (секунды). 0 — закрывать после каждого запроса.
# Разработка: 60. Несколько воркеров за nginx: 300–600 (см. блок «Несколько процессов»).
API_DATABASE_CONN_MAX_AGE=60

# Сжатие JSON-ответов API (GZipMiddleware). При nginx с brotli/gzip можно отключить.
API_GZIP_ENABLED=true

# Проверка подключений к БД при старте. На стабильном сервере: false (быстрее старт воркеров).
DATABASE_TEST_CONNECTIONS=true

# --- Регистрация и профиль ---

# Режим регистрации: open | invitation | closed
API_REGISTRATION_MODE=open
# Срок действия приглашения в днях (для режима invitation)
API_REGISTRATION_INVITATION_TTL_DAYS=7
# true — запретить дубликаты email; false — не проверять (по умолчанию)
API_REGISTRATION_CHECK_EMAIL_EXISTS=false
# true — восстановление пароля через форму «Забыл пароль» (по умолчанию)
API_PASSWORD_RESET_ENABLED=true
# true — пользователи меняют email, ФИО и телефон сами; false — только через заявки администратору
API_USER_PROFILE_SELF_EDIT_ENABLED=true
# Базовый URL клиента для ссылок в письмах (по умолчанию http://CLIENT_HOST:CLIENT_PORT)
# FRONTEND_BASE_URL=https://app.example.com

# --- Политика паролей ---

API_PASSWORD_MIN_LENGTH=6
API_PASSWORD_MAX_LENGTH=20
API_PASSWORD_REQUIRE_LOWERCASE=true
API_PASSWORD_REQUIRE_UPPERCASE=false
API_PASSWORD_REQUIRE_DIGIT=true
API_PASSWORD_REQUIRE_SPECIAL=false
API_PASSWORD_VALIDATE_USER_ATTRIBUTE_SIMILARITY=true
API_PASSWORD_VALIDATE_COMMON_PASSWORD=true
API_PASSWORD_VALIDATE_NUMERIC_ONLY=true

# --- Клиент ---

CLIENT_HOST=localhost
CLIENT_PORT=8001
CLIENT_DEPLOY_TYPE=development
CLIENT_DEFAULT_THEME=auto

# Уровень логирования клиента в DevTools: debug, info, warn, error, critical, silent
# Не влияет на запись ошибок на сервер (CLIENT_BROWSER_LOG_*).
CLIENT_LOG_LEVEL=debug

# Отправка ошибок клиента на сервер → logs/client-browser.log (POST /api/cms/client-log/)
CLIENT_BROWSER_LOG_ENABLED=true

# true — API и WebSocket с того же origin, что и SPA (nginx, туннели)
CLIENT_USE_RELATIVE_API=false

# Фоновый опрос /maintenance.json (каждые ~3 с). Для production с nginx — true
CLIENT_MAINTENANCE_POLL_ENABLED=false

# --- Jupyter (ergoms start-jupyter) ---
# Режимы: local (только эта машина) | lan (IP:порт + токен) | nginx (за прокси + токен + админ) | auto
API_JUPYTER_ACCESS_MODE=auto
API_JUPYTER_BEHIND_NGINX=false
API_JUPYTER_ALLOW_REMOTE=false
# API_JUPYTER_BIND_HOST=   # явный bind; иначе из режима (local→localhost, lan→0.0.0.0, nginx→127.0.0.1)
API_JUPYTER_BIND_PORT=8002
# API_JUPYTER_BASE_PATH=/jupyter/
# API_JUPYTER_URL=         # явный публичный URL (override)
# API_JUPYTER_TOKEN=       # обязателен для lan/nginx (openssl rand -hex 32)
API_JUPYTER_TRUST_XHEADERS=true

# --- Почта ---

# true — включить SMTP на prod/staging
EMAIL_ENABLED=false
EMAIL_HOST_USER=mail
EMAIL_HOST_PASSWORD=password
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# --- Логирование (каталог logs/, переопределение ERGO_LOGS_DIR) ---

# Файлы пишутся всегда; консоль служб отключена (ERGO_LOG_CONSOLE=false в systemd/NSSM).
# ERGO_LOGS_DIR=
ERGO_LOG_FILE_LEVEL=debug
ERGO_LOG_CONSOLE_LEVEL=info
# ERGO_LOG_CONSOLE=true

# Ротация: Python-сервисы (API, Celery, media_api)
# ERGO_LOG_MAX_BYTES=10485760
# ERGO_LOG_BACKUP_COUNT=5
# ERGO_LOG_BROKER_MAX_BYTES=5242880
# ERGO_LOG_BROKER_BACKUP_COUNT=3

# Ротация: nginx, Redis, Vite dev-сервер
# ERGO_LOG_INFRA_ROTATE_ENABLED=true
# ERGO_LOG_INFRA_MAX_BYTES=10485760
# ERGO_LOG_INFRA_BACKUP_COUNT=5
# ERGO_LOG_NGINX_MAX_BYTES=
# ERGO_LOG_NGINX_BACKUP_COUNT=
# ERGO_LOG_REDIS_MAX_BYTES=
# ERGO_LOG_REDIS_BACKUP_COUNT=
# ERGO_LOG_CLIENT_DEV_MAX_BYTES=
# ERGO_LOG_CLIENT_DEV_BACKUP_COUNT=
# ERGO_LOG_INFRA_ROTATE_HOUR=3
# ergoms rotate-logs — вручную; ergoms install-infra-log-rotate — cron / Task Scheduler

# Имена файлов (basename в ERGO_LOGS_DIR; необязательно)
# ERGO_LOG_FILE_API=api.log
# ERGO_LOG_FILE_MEDIA_API=media_api.log
# ERGO_LOG_FILE_CELERY=celery.log
# ERGO_LOG_FILE_CELERY_WORKER=celery_worker.log
# ERGO_LOG_FILE_CELERY_BEAT=celery_beat.log
# ERGO_LOG_FILE_CELERY_TASKS=celery_tasks.log
# ERGO_LOG_FILE_CELERY_BROKER=celery_broker.log
# ERGO_LOG_FILE_NGINX_ACCESS=nginx-access.log
# ERGO_LOG_FILE_NGINX_ERROR=nginx-error.log
# ERGO_LOG_FILE_REDIS=redis.log
# ERGO_LOG_FILE_CLIENT_DEV=client-dev.log
# ERGO_LOG_FILE_CLIENT_BROWSER=client-browser.log
# ERGO_LOG_FILE_AUDIT=audit.log

# Уровни по компонентам (fallback: ERGO_LOG_FILE_LEVEL)
# API_LOG_FILE_LEVEL=debug
# API_LOG_CONSOLE_LEVEL=info
# API_LOG_CONSOLE=true
# CELERY_LOG_FILE_LEVEL=debug
# CELERY_LOG_CONSOLE=false
# CELERY_BEAT_LOG_FILE_LEVEL=debug
# MEDIA_API_LOG_FILE_LEVEL=debug
# MEDIA_API_LOG_CONSOLE=false

# Уровни отдельных файлов (переопределяют *_LOG_FILE_LEVEL компонента)
# ERGO_LOG_LEVEL_CELERY_BROKER=info
# ERGO_LOG_LEVEL_CLIENT_BROWSER=warning
# ERGO_LOG_LEVEL_AUDIT=info

# Vite dev-сервер (ergo-client-dev, ergoms start-client)
# CLIENT_DEV_LOG_ENABLED=true
# CLIENT_DEV_LOG_LEVEL=info

# nginx (после изменения: ergoms reload-nginx)
# NGINX_ERROR_LOG_LEVEL=warn
# NGINX_ACCESS_LOG_ENABLED=true

# Redis (после изменения: ergoms install-redis --configure)
# REDIS_LOG_LEVEL=notice

# Полные списки модулей и очередей при ergoms start-worker / start-beat (или флаг --verbose)
# ERGO_CELERY_STARTUP_VERBOSE=false

# --- Media API ---

# CDN для /serve/ и /upload/ (подписанные URL). Dev: http://localhost:BIND_PORT без MEDIA_API_URL.
# MEDIA_ACCESS_MODE: local — core/api читает <корень>/media; remote — HTTP к media_api (разные серверы).
MEDIA_API_BIND_HOST=127.0.0.1
MEDIA_API_BIND_PORT=8003
MEDIA_ACCESS_MODE=local
MEDIA_API_DEPLOY_TYPE=development

# Публичный хост media_api за nginx (если MEDIA_API_URL не задан):
# MEDIA_API_HOST=app.example.com
# MEDIA_API_PORT=443
# MEDIA_API_PROTOCOL=https
# MEDIA_API_URL=https://app.example.com
# MEDIA_API_ALLOWED_HOSTS=app.example.com

# Редирект HTTP → HTTPS в Django media_api (true только если TLS на самом процессе, не за nginx):
# MEDIA_API_SECURE_SSL_REDIRECT=false

# Нестандартный путь к файлам (по умолчанию <корень_проекта>/media):
# MEDIA_STORAGE_PATH=/data/media

# MEDIA_ACCESS_MODE=remote:
# MEDIA_API_INTERNAL_KEY=          # openssl rand -hex 32, одинаково на обоих
# MEDIA_API_INTERNAL_URL=http://10.0.0.5:8003

# Production за nginx: core/deployment/nginx/env.example

# --- Realtime ---

# websocket | sse | http_polling (сервер и клиент — только REALTIME_*)
REALTIME_TRANSPORT=websocket
# REALTIME_SSE_KEEPALIVE_INTERVAL=25

# Channel layer: memory (dev, один процесс) | postgres | redis (несколько воркеров — см. блок ниже)
# CHANNEL_LAYER_BACKEND=memory
# CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/0

# Интервалы polling, секунды (клиент × 1000 автоматически). Dev — значения по умолчанию в realtime.py:
# REALTIME_POLL_PRESENCE_INTERVAL=45
# REALTIME_POLL_NOTIFICATIONS_INTERVAL=15
# REALTIME_POLL_ADMIN_PRESENCE_INTERVAL=10
# REALTIME_POLL_MESSENGER_INTERVAL=5
# Несколько воркеров (снизить RPS): presence 60–90, notifications 30, admin_presence 30, messenger 10–15

# --- Nginx (dev: выключен; production — core/deployment/nginx/env.example) ---

# ergoms install-nginx. При true: ergoms start-client не поднимает Vite, API/Media на 127.0.0.1
NGINX_ENABLED=false
NGINX_PUBLIC_HOST=
NGINX_LISTEN_HOST=0.0.0.0
NGINX_SERVER_NAME=localhost
NGINX_LISTEN_PORT=80
# allow | redirect | deny — доступ по IP и неканоническому Host
# NGINX_ALT_HOSTS=
NGINX_HOST_POLICY=allow
NGINX_USE_HTTPS=false

# TLS, CORS (production): core/deployment/nginx/env.example, ergoms install-tls / status-tls
# ERGO_TLS_EMAIL=admin@example.com
# ERGO_TLS_DOMAINS=app.example.com,www.app.example.com
# ERGO_TLS_WEBROOT=/var/www/certbot
# ERGO_TLS_STAGING=false
# ERGO_SSL_CERT=/etc/letsencrypt/live/app.example.com/fullchain.pem
# ERGO_SSL_KEY=/etc/letsencrypt/live/app.example.com/privkey.pem
# SECURE_SSL_REDIRECT=false
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Кэш Django ---

# locmem | file | redis | dummy. Dev (ergoms dev): locmem. Несколько воркеров: redis (см. блок ниже).
# file — без Redis на Linux; не рекомендуется на Windows.
API_CACHE_BACKEND=locmem
# API_CACHE_REDIS_URL=redis://127.0.0.1:6379/1
API_CACHE_DEFAULT_TIMEOUT=300
API_MENU_CACHE_TTL=300
API_PERMISSIONS_SNAPSHOT_CACHE_TTL=60
API_NOTIFICATIONS_UNREAD_CACHE_TTL=45

# Celery broker/result: auto | redis | database | local (см. блок ниже и databases.yaml)
# CELERY_BROKER_BACKEND=auto
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
# Расписание Beat (django-celery-beat) — в PostgreSQL, не в Redis

# --- Несколько процессов (API/Celery за nginx, production) ---
# Установка Redis: ergoms install-redis (бинарники — virtual_env/packages/redis/)
# URL кэша, channel layer и Celery broker — src.config.redis_runtime
#
# REDIS_ENABLED=true
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB_CHANNEL=0
# REDIS_DB_CACHE=1
# REDIS_DB_CELERY_BROKER=2
# REDIS_DB_CELERY_RESULT=3
# API_CACHE_BACKEND=redis
# API_CACHE_REDIS_URL=redis://127.0.0.1:6379/1
# CHANNEL_LAYER_BACKEND=redis
# CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_BACKEND=redis
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
# API_DATABASE_CONN_MAX_AGE=300
# API_GZIP_ENABLED=false
# AUDIT_ASYNC_PERSIST=true

# --- Сессии устройств ---

API_DEVICE_SESSION_CACHE_TTL=45
API_DEVICE_ACTIVITY_DEBOUNCE_SEC=120

# --- Аудит ---

AUDIT_ASYNC_PERSIST=false
AUDIT_ASYNC_PERSIST_FALLBACK_SYNC=true
AUDIT_RETENTION_DAYS=0
AUDIT_LOG_FILE_ENABLED=true
# AUDIT_LOG_FILE_LEVEL=info
# Ручной purge: ergoms api audit_purge [--days N] [--dry-run]

# --- MCP ---

ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# --- Модули и изоляция ---

# Через запятую. Пример: DISABLED_MODULES=video_analysis,bi_analysis
DISABLED_MODULES=

# off | warn | raise — прямой импорт modules.<Y> из modules.<X> (ModuleBridge)
BRIDGE_ISOLATION=warn

# --- Docker (ergoms docker *) ---
# Шаблон для Docker: .env.docker.example (скопируйте в .env)

# Включить Docker-режим (ergoms docker up вместо portable redis/nginx на хосте)
DOCKER_ENABLED=false

# dev — bind-mount кода, runserver, Vite dev
# prod — daphne, client-build, опционально nginx
DOCKER_MODE=dev

# compose project name и каталог (относительно корня)
DOCKER_COMPOSE_PROJECT=ergo_ms
DOCKER_COMPOSE_DIR=core/deployment/docker

# PostgreSQL: container | host
# host/port/user/password/name — из databases.yaml (секция default и celery*)
# при container: localhost/127.0.0.1 в yaml → имя сервиса postgres внутри сети compose
# при host: host/port в yaml как есть (для Docker Desktop — host.docker.internal в databases.yaml)
DOCKER_DATABASE=container

# Profiles (true/false) — какие optional-сервисы поднимать
DOCKER_PROFILE_NGINX=false
DOCKER_PROFILE_JUPYTER=false
DOCKER_PROFILE_POSTGRES=true

# Образы (можно переопределить)
# DOCKER_PYTHON_IMAGE=ergo_ms-python:local
# DOCKER_NODE_IMAGE=node:20-bookworm-slim
# DOCKER_NGINX_IMAGE=nginx:1.27-alpine
# DOCKER_REDIS_IMAGE=redis:7-alpine
# DOCKER_POSTGRES_IMAGE=postgres:16-alpine

# Публикация портов на хост — из существующих ключей .env:
# API_PORT, CLIENT_PORT, MEDIA_API_BIND_PORT, API_JUPYTER_BIND_PORT, NGINX_LISTEN_PORT
# (при profile nginx на хост обычно публикуется только NGINX_LISTEN_PORT)

# Имена сервисов в compose-сети (для effective env)
DOCKER_SERVICE_API=api
DOCKER_SERVICE_MEDIA=media-api
DOCKER_SERVICE_REDIS=redis
DOCKER_SERVICE_POSTGRES=postgres

# Тома: bind — каталог проекта; named — docker volume
DOCKER_VOLUME_LOGS=bind
DOCKER_VOLUME_MEDIA=bind
DOCKER_VOLUME_CELERY_CACHE=named
# DOCKER_REDIS_PERSIST=false

# --- GeoIP ---

GEOIP_ENABLED=false
# URL архива MMDB (или ergoms api download_geoip_db подберёт fallback)
GEOIP_DOWNLOAD_URL=https://download.db-ip.com/free/dbip-city-lite-2026-07.mmdb.gz
