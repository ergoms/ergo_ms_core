# Хост и порт для API сервера
API_HOST=localhost
API_PORT=8000

# Разрешенные хосты для API (через запятую)
API_ALLOWED_HOSTS=localhost,127.0.0.1

# Тип развертывания API: development (разработка) или production (продакшн)
API_DEPLOY_TYPE=development

# Документация API (Swagger UI / ReDoc):
# true  — доступны /swagger/ и /redoc/
# false — маршруты документации отключены
# По умолчанию: включено в development, выключено в production
API_SWAGGER_ENABLED=true

# HTML-формы Django REST Framework на /api/... (Browsable API):
# true  — в браузере видны интерактивные страницы DRF
# false — только JSON-ответы
# По умолчанию: включено в development, выключено в production
API_DRF_BROWSABLE_ENABLED=true

# JWT Tokens (время жизни в минутах)
# true  — ограничивать срок жизни (используются значения ниже)
# false — срок жизни не ограничивается (значения lifetime игнорируются)
API_JWT_LIFETIME_ENABLED=true
API_ACCESS_TOKEN_LIFETIME=30
API_REFRESH_TOKEN_LIFETIME=60

# Режим регистрации пользователей:
# open       — свободная регистрация (по умолчанию)
# invitation — только по приглашению администратора (UserRole «Администратор»)
# closed     — регистрация отключена
API_REGISTRATION_MODE=open
# Срок действия приглашения в днях (для режима invitation)
API_REGISTRATION_INVITATION_TTL_DAYS=7
# Проверка уникальности email (регистрация, обновление профиля, импорт пользователей)
# true  — запретить дубликаты email
# false — не проверять (по умолчанию)
API_REGISTRATION_CHECK_EMAIL_EXISTS=false
# Восстановление пароля пользователями через форму «Забыл пароль»
# true  — включено (по умолчанию)
# false — отключено; восстановление только через администратора
API_PASSWORD_RESET_ENABLED=true
# Самостоятельное изменение email и ФИО пользователями в настройках профиля
# true  — пользователи могут менять email и ФИО сами (по умолчанию)
# false — email и ФИО меняют только администраторы; пользователи отправляют заявки
API_USER_PROFILE_SELF_EDIT_ENABLED=true
# Базовый URL клиента для ссылок в письмах (по умолчанию http://CLIENT_HOST:CLIENT_PORT)
# FRONTEND_BASE_URL=https://app.example.com

# Время жизни токенов при "Запомнить меня" (только при API_JWT_LIFETIME_ENABLED=true)
# access = 3 дня, refresh = 7 дней
API_REMEMBER_ME_ACCESS_TOKEN_LIFETIME=4320
API_REMEMBER_ME_REFRESH_TOKEN_LIFETIME=10080

# Настройки ограничения частоты запросов (rate limiting)
# API_THROTTLE_RATES_ANON - для анонимных пользователей
# API_THROTTLE_RATES_USER - для авторизованных пользователей
API_THROTTLE_RATES_ANON=100/minute
API_THROTTLE_RATES_USER=6000/hour

# Секретный ключ для Django (используется для криптографии, подписей и т.д.)
API_SECRET_KEY=secret-key

# Отдельный ключ для подписи JWT-токенов (если не задан, используется API_SECRET_KEY)
# Рекомендуется задать уникальный ключ в production
# API_JWT_SIGNING_KEY=your-jwt-signing-key

# Политика паролей (регистрация, смена пароля, сброс, админ-панель)
# Минимальное количество символов в пароле
API_PASSWORD_MIN_LENGTH=6
# Максимальное количество символов в пароле (0 = без ограничения)
API_PASSWORD_MAX_LENGTH=20
# Пароль должен содержать хотя бы одну строчную букву (a-z)
API_PASSWORD_REQUIRE_LOWERCASE=true
# Пароль должен содержать хотя бы одну заглавную букву (A-Z)
API_PASSWORD_REQUIRE_UPPERCASE=false
# Пароль должен содержать хотя бы одну цифру (0-9)
API_PASSWORD_REQUIRE_DIGIT=true
# Пароль должен содержать хотя бы один спецсимвол (!@#$% и т.п., не буква и не цифра)
API_PASSWORD_REQUIRE_SPECIAL=false
# Отклонять пароли, схожие с именем, email или логином пользователя (Django UserAttributeSimilarityValidator)
API_PASSWORD_VALIDATE_USER_ATTRIBUTE_SIMILARITY=true
# Отклонять часто используемые и легко взламываемые пароли (Django CommonPasswordValidator)
API_PASSWORD_VALIDATE_COMMON_PASSWORD=true
# Отклонять пароли, состоящие только из цифр (Django NumericPasswordValidator)
API_PASSWORD_VALIDATE_NUMERIC_ONLY=true

# Хост и порт для клиентского приложения
CLIENT_HOST=localhost
CLIENT_PORT=8001

# Тип развертывания клиента: development (разработка) или production (продакшн)
CLIENT_DEPLOY_TYPE=development

# Хост и порт для Jupyter сервера
API_JUPYTER_HOST=localhost
API_JUPYTER_PORT=8002

# По умолчанию false (можно не указывать). true — включить SMTP на prod/staging
EMAIL_ENABLED=false

# Учетные данные для SMTP сервера
EMAIL_HOST_USER=mail
EMAIL_HOST_PASSWORD=password
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465

# Использование TLS (Transport Layer Security)
EMAIL_USE_TLS=False

# Использование SSL (Secure Sockets Layer)
EMAIL_USE_SSL=True

# Тема по умолчанию для интерфейса: auto, light, dark
VITE_DEFAULT_THEME=auto

# Уровень логирования: debug, info, warn, error, critical, silent
VITE_LOG_LEVEL=debug

# Media API — CDN для /serve/ и /upload/ (подписанные URL)
# Минимум для dev. Публичный URL без MEDIA_API_URL: http://localhost:BIND_PORT.
# MEDIA_ACCESS_MODE: local — core/api читает <корень>/media напрямую; remote — HTTP к media_api.
MEDIA_API_BIND_PORT=8003
MEDIA_ACCESS_MODE=local
MEDIA_API_DEPLOY_TYPE=development

# Публичный адрес в подписанных ссылках (nginx / HTTPS / нестандартный хост):
# MEDIA_API_URL=https://app.example.com

# Нестандартный путь к файлам (по умолчанию <корень_проекта>/media):
# MEDIA_STORAGE_PATH=/data/media

# MEDIA_ACCESS_MODE=remote — core/api и media_api на разных серверах:
# MEDIA_API_INTERNAL_KEY=          # openssl rand -hex 32, одинаково на обоих
# MEDIA_API_INTERNAL_URL=http://10.0.0.5:8003

# Production / nginx: core/deployment/nginx/env.example

# Логин администратора системы для подключения API к MCP
ADMIN_LOGIN=admin

# Пароль администратора системы для подключения API к MCP
ADMIN_PASSWORD=admin

# VITE_USE_RELATIVE_API=true — для временных туннелей (один туннель на клиент, API через прокси)
VITE_USE_RELATIVE_API=false

# Realtime: websocket (Channels) или http_polling (REST + short polling, обход прокси без WS)
# websocket | http_polling
REALTIME_TRANSPORT=websocket
# Интервалы polling на сервере — секунды (клиент при сборке: VITE_* в мс или REALTIME_* × 1000)
# REALTIME_POLL_PRESENCE_INTERVAL=45
# REALTIME_POLL_NOTIFICATIONS_INTERVAL=15
# REALTIME_POLL_ADMIN_PRESENCE_INTERVAL=10
# REALTIME_POLL_MESSENGER_INTERVAL=5
# VITE_REALTIME_TRANSPORT=websocket
# VITE_REALTIME_POLL_PRESENCE_INTERVAL=45000
# VITE_REALTIME_POLL_NOTIFICATIONS_INTERVAL=15000
# VITE_REALTIME_POLL_ADMIN_PRESENCE_INTERVAL=10000
# VITE_REALTIME_POLL_MESSENGER_INTERVAL=5000

# Nginx reverse proxy (опциональный сценарий)
# Включает работу системы через nginx. Не входит в стандартную установку.
# Для активации: ergoms install-nginx (скачает nginx, сгенерирует конфиг, запустит)
# false — стандартный режим (клиент и API на отдельных портах)
# true  — все сервисы за nginx (один порт, SPA + API + WS + Media + Static)
# При true: ergoms start-client не поднимает Vite (:8001), API/Media на 127.0.0.1
NGINX_ENABLED=false
# Публичный IP или hostname для доступа к системе (не localhost)
# Пусто — автоопределение LAN IP при install-nginx
NGINX_PUBLIC_HOST=
# Адрес bind nginx (0.0.0.0 — доступ из LAN; 127.0.0.1 — только локально)
NGINX_LISTEN_HOST=0.0.0.0
# server_name в конфиге nginx (fallback, если NGINX_PUBLIC_HOST пуст)
NGINX_SERVER_NAME=localhost
# Порт, на котором слушает nginx
NGINX_LISTEN_PORT=80
# NGINX_HOST_POLICY — доступ по IP и неканоническому Host (требует домен в NGINX_PUBLIC_HOST):
#   allow    — IP и домен работают (по умолчанию)
#   redirect — IP и NGINX_ALT_HOSTS редиректятся на канонический домен
#   deny     — IP и alt-host отклоняются (nginx 444)
# NGINX_ALT_HOSTS=  — доп. адреса для redirect/deny (LAN IP подставляется автоматически)
NGINX_HOST_POLICY=allow
# true или порт 443 — HTTPS-шаблон с TLS hardening (production)
NGINX_USE_HTTPS=false
# Let's Encrypt (Linux: ergoms install-tls)
# ERGO_TLS_EMAIL=admin@example.com
# ERGO_TLS_DOMAINS=app.example.com,www.app.example.com
# ERGO_TLS_WEBROOT=/var/www/certbot
# ERGO_TLS_STAGING=false
# Пути к TLS-сертификату (Linux production, Let's Encrypt)
# ERGO_SSL_CERT=/etc/letsencrypt/live/app.example.com/fullchain.pem
# ERGO_SSL_KEY=/etc/letsencrypt/live/app.example.com/privkey.pem

# Проверка подключений к БД при старте (true/false).
# По умолчанию проверяется; только если явно false в .env — проверка отключается (ускоряет запуск в dev)
DATABASE_TEST_CONNECTIONS=true

# Runtime-страж изоляции модулей ModuleBridge.
# Реакция на прямой импорт `modules.<Y>` из кода другого модуля `modules.<X>`:
#   off   - проверка отключена
#   warn  - предупреждение через warnings + запись в лог (по умолчанию)
#   raise - выбросить BridgeIsolationError (рекомендуется для CI/тестов)
BRIDGE_ISOLATION=warn

# Отключение модулей (через запятую). Модули из этого списка не загружаются:
# API (INSTALLED_APPS, URLs, Swagger, Celery), Client (routes, endpoints, menu).
# Пример: DISABLED_MODULES=video_analysis,bi_analysis,vacancies_parser
DISABLED_MODULES=

# То же значение для клиента (Vite). Должно совпадать с DISABLED_MODULES.
# Позволяет фильтровать модули на клиенте без запроса к API.
VITE_DISABLED_MODULES=