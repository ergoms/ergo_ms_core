# Хост и порт для API сервера
API_HOST=localhost
API_PORT=8000

# Разрешенные хосты для API (через запятую)
API_ALLOWED_HOSTS=localhost,127.0.0.1

# Тип развертывания API: development (разработка) или production (продакшн)
API_DEPLOY_TYPE=development

# JWT Tokens (время жизни в минутах)
# true  — ограничивать срок жизни (используются значения ниже)
# false — срок жизни не ограничивается (значения lifetime игнорируются)
API_JWT_LIFETIME_ENABLED=true
API_ACCESS_TOKEN_LIFETIME=60
API_REFRESH_TOKEN_LIFETIME=600

# Время жизни токенов при "Запомнить меня" (только при API_JWT_LIFETIME_ENABLED=true)
# access = 3 дня, refresh = 7 дней
API_REMEMBER_ME_ACCESS_TOKEN_LIFETIME=4320
API_REMEMBER_ME_REFRESH_TOKEN_LIFETIME=10080

# Настройки ограничения частоты запросов (rate limiting)
# API_THROTTLE_RATES_ANON - для анонимных пользователей
# API_THROTTLE_RATES_USER - для авторизованных пользователей
API_THROTTLE_RATES_ANON=100/minute
API_THROTTLE_RATES_USER=6000/hour

# Секретный ключ для Django (используется для криптографии, подписей и т.д.)
API_SECRET_KEY=secret-key

# Политика паролей (регистрация, смена пароля, сброс, админ-панель)
# Минимальное количество символов в пароле
API_PASSWORD_MIN_LENGTH=6
# Максимальное количество символов в пароле (0 = без ограничения)
API_PASSWORD_MAX_LENGTH=20
# Пароль должен содержать хотя бы одну строчную букву (a-z)
API_PASSWORD_REQUIRE_LOWERCASE=true
# Пароль должен содержать хотя бы одну заглавную букву (A-Z)
API_PASSWORD_REQUIRE_UPPERCASE=false
# Пароль должен содержать хотя бы одну цифру (0-9)
API_PASSWORD_REQUIRE_DIGIT=true
# Пароль должен содержать хотя бы один спецсимвол (!@#$% и т.п., не буква и не цифра)
API_PASSWORD_REQUIRE_SPECIAL=false
# Отклонять пароли, схожие с именем, email или логином пользователя (Django UserAttributeSimilarityValidator)
API_PASSWORD_VALIDATE_USER_ATTRIBUTE_SIMILARITY=true
# Отклонять часто используемые и легко взламываемые пароли (Django CommonPasswordValidator)
API_PASSWORD_VALIDATE_COMMON_PASSWORD=true
# Отклонять пароли, состоящие только из цифр (Django NumericPasswordValidator)
API_PASSWORD_VALIDATE_NUMERIC_ONLY=true

# Хост и порт для клиентского приложения
CLIENT_HOST=localhost
CLIENT_PORT=8001

# Тип развертывания клиента: development (разработка) или production (продакшн)
CLIENT_DEPLOY_TYPE=development

# Хост и порт для Jupyter сервера
API_JUPYTER_HOST=localhost
API_JUPYTER_PORT=8002

# Учетные данные для SMTP сервера
EMAIL_HOST_USER=mail
EMAIL_HOST_PASSWORD=password
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465

# Использование TLS (Transport Layer Security)
EMAIL_USE_TLS=False

# Использование SSL (Secure Sockets Layer)
EMAIL_USE_SSL=True

# Тема по умолчанию для интерфейса: auto, light, dark
VITE_DEFAULT_THEME=auto

# Уровень логирования: debug, info, warn, error
VITE_LOG_LEVEL=debug

# Порог для асинхронной обработки предпросмотра датасета (по умолчанию: 5000)
# Если количество строк превышает это значение и есть JOIN'ы, предпросмотр обрабатывается асинхронно через Celery
BI_PREVIEW_ASYNC_THRESHOLD=5000

# Пайплайн: лимит строк источника (пусто/none = без лимита при execute)
BI_ANALYSIS_SOURCE_LIMIT=

# Пайплайн: порог строк для переключения на асинхронное выполнение через Celery (по умолчанию: 100000)
BI_ANALYSIS_ASYNC_THRESHOLD=100000

# Пайплайн: push-down фильтров и агрегаций в SQL (true/false, по умолчанию: true)
BI_ANALYSIS_USE_SQL_PUSHDOWN=true

# Размер чанка при подгрузке данных предпросмотра пайплайна (по умолчанию: 5000)
# Должен совпадать с BI_ANALYSIS_EXECUTE_CHUNK_SIZE на бэкенде для согласованной подгрузки
VITE_BI_EXECUTE_CHUNK_SIZE=5000

# Количество строк на странице при пагинации предпросмотра (по умолчанию: 20)
# Определяет, сколько строк отображается на одной странице в таблице предпросмотра датасета
VITE_BI_PREVIEW_ITEMS_PER_PAGE=200

# Максимальный размер файла для загрузки в модуль аналитики (по умолчанию 1000)
VITE_BI_UPLOAD_MAX_SIZE_MB=1000

# URL для Ollama (локальный сервер для запуска языковых моделей)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Модель Ollama по умолчанию (например: mistral:7b, llama3:8b, qwen2:7b)
OLLAMA_DEFAULT_MODEL=mistral:7b

# Модель Ollama для генерации embeddings (векторных представлений) в RAG
OLLAMA_EMBEDDINGS_MODEL=embeddinggemma

# Использовать прямой API Ollama (Обычно работает намного быстрее)
OLLAMA_USE_DIRECT_API=true

# Media API (CDN / file server)
# Хост и порт для Media API сервиса
MEDIA_API_HOST=localhost
MEDIA_API_PORT=8003

# Протокол для формирования подписанных URL (http / https)
MEDIA_API_PROTOCOL=http

# Тип хранилища файлов: local (локальная ФС), в будущем s3/minio
MEDIA_STORAGE_TYPE=local

# Путь к хранилищу файлов (пусто = <корень_проекта>/media)
MEDIA_STORAGE_PATH=

# Время жизни подписанного URL для скачивания файла (в секундах, по умолчанию: 1 час)
MEDIA_URL_EXPIRATION=3600

# Максимальный размер загружаемого файла (в байтах, по умолчанию: 100 МБ)
MEDIA_UPLOAD_MAX_SIZE=104857600

# Время жизни upload-токена (в секундах, по умолчанию: 5 минут)
MEDIA_UPLOAD_TOKEN_EXPIRATION=300

# Логин администратора системы для подключения API к MCP
ADMIN_LOGIN=admin

# Пароль администратора системы для подключения API к MCP
ADMIN_PASSWORD=admin

# VITE_USE_RELATIVE_API=true — для временных туннелей (один туннель на клиент, API через прокси)
VITE_USE_RELATIVE_API=false

# Проверка подключений к БД при старте (true/false).
# По умолчанию проверяется; только если явно false в .env — проверка отключается (ускоряет запуск в dev)
DATABASE_TEST_CONNECTIONS=true

# Ключ Fernet для шифрования конфигов БД-подключений в bi_analysis
# Сгенерировать: ergoms api generate_fernet_key
FERNET_KEY=

# Runtime-страж изоляции модулей ModuleBridge.
# Реакция на прямой импорт `modules.<Y>` из кода другого модуля `modules.<X>`:
#   off   - проверка отключена
#   warn  - предупреждение через warnings + запись в лог (по умолчанию)
#   raise - выбросить BridgeIsolationError (рекомендуется для CI/тестов)
BRIDGE_ISOLATION=warn