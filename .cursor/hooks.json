{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 core/deployment/scripts/cursor_browser_auth.py --hook"
      },
      {
        "command": "python3 core/deployment/scripts/cursor_browser_queue.py --hook-session"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 core/deployment/scripts/cursor_browser_queue.py --hook-before",
        "timeout": 300
      }
    ],
    "afterMCPExecution": [
      {
        "command": "python3 core/deployment/scripts/cursor_browser_queue.py --hook-after"
      }
    ],
    "stop": [
      {
        "command": "python3 core/deployment/scripts/cursor_browser_queue.py --hook-release"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 core/deployment/scripts/cursor_browser_queue.py --hook-release"
      }
    ]
  }
}
