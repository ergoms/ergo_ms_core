{
    "mcpServers": {
        "ergo-api": {
            "command": "node",
            "args": [
                ".cursor/mcp_launcher.js",
                ".cursor/mcp_api_server.py"
            ],
            "disabled": true
        },
        "ergo-database-celery": {
            "command": "node",
            "args": [
                ".cursor/mcp_launcher.js",
                ".cursor/mcp_database_wrapper.py",
                "celery"
            ],
            "disabled": true
        },
        "ergo-database-celery-beat": {
            "command": "node",
            "args": [
                ".cursor/mcp_launcher.js",
                ".cursor/mcp_database_wrapper.py",
                "celery_beat"
            ],
            "disabled": true
        },
        "ergo-database-celery-worker": {
            "command": "node",
            "args": [
                ".cursor/mcp_launcher.js",
                ".cursor/mcp_database_wrapper.py",
                "celery_worker"
            ],
            "disabled": true
        },
        "ergo-database-default": {
            "command": "node",
            "args": [
                ".cursor/mcp_launcher.js",
                ".cursor/mcp_database_wrapper.py",
                "default"
            ],
            "disabled": true
        },
        "ergo-filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "."
            ],
            "disabled": true
        },
        "ergo-media-api": {
            "command": "node",
            "args": [
                ".cursor/mcp_launcher.js",
                ".cursor/mcp_media_api_server.py"
            ],
            "disabled": true
        }
    }
}
