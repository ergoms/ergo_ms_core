{
    "mcpServers": {
        "ergo-filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "."
            ]
        },
        "ergo-database-postgres": {
            "command": "bash",
            "args": [
                ".cursor/mcp_launcher.sh",
                ".cursor/mcp_python_wrapper.py",
                ".cursor/mcp_database_wrapper.py",
                "default"
            ]
        },
        "ergo-api": {
            "command": "bash",
            "args": [
                ".cursor/mcp_launcher.sh",
                ".cursor/mcp_python_wrapper.py",
                ".cursor/mcp_api_server.py"
            ]
        },
        "ergo_ollama": {
            "command": "bash",
            "args": [
                ".cursor/mcp_launcher.sh",
                ".cursor/mcp_python_wrapper.py",
                ".cursor/mcp_ollama_server.py"
            ]
        }
    }
}