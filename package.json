{
  "name": "ergo-ms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ErgoMS - модульная система управления",
  "workspaces": [
    "core/client",
    "modules/*/client"
  ],
  "scripts": {
    "dev": "cd core/client && npm run dev",
    "stop-dev": "cd core/client && npm run stop-dev",
    "build": "cd core/client && npm run build",
    "preview": "cd core/client && npm run preview",
    "lint": "cd core/client && npm run lint",
    "format": "cd core/client && npm run format",
    "install:all": "npm install && npm install --workspaces"
  },
  "script_comments": {
    "dev": "Запуск сервера разработки",
    "stop-dev": "Остановка сервера разработки",
    "build": "Сборка проекта",
    "preview": "Предварительный просмотр сборки",
    "lint": "Проверка и исправление кода с помощью ESLint",
    "format": "Форматирование кода с помощью Prettier",
    "install:all": "Установка всех зависимостей для всех workspace"
  }
}
