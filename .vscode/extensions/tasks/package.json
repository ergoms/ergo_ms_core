{
  "name": "ergo-ms-tasks",
  "displayName": "ERGO MS Tasks",
  "description": "Задачи VS Code/Cursor: multi-terminal и модульные задачи Run Task (modules/<name>/vscode.tasks.yaml).",
  "version": "1.4.1",
  "publisher": "ergo-ms",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:multi-terminal",
    "onTaskType:ergo-module"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ergo-ms-tasks.run",
        "title": "ERGO MS: Run Multi-Terminal"
      },
      {
        "command": "ergo-ms-tasks.runFromFile",
        "title": "ERGO MS: Run Multi-Terminal from File"
      },
      {
        "command": "ergo-ms-tasks.stopAll",
        "title": "ERGO MS: Stop All Terminals"
      }
    ],
    "taskDefinitions": [
      {
        "type": "multi-terminal",
        "required": [],
        "properties": {
          "terminals": {
            "type": "array",
            "description": "Список терминалов для запуска",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Имя терминала"
                },
                "command": {
                  "type": "string",
                  "description": "Команда для выполнения"
                },
                "cwd": {
                  "type": "string",
                  "description": "Рабочая директория"
                }
              }
            }
          },
          "source": {
            "type": "object",
            "description": "Источник данных (файл yaml/json) - один источник",
            "properties": {
              "file": {
                "type": "string",
                "description": "Путь к файлу"
              },
              "path": {
                "type": "string",
                "description": "Путь к списку в файле (например: workers)"
              }
            }
          },
          "sources": {
            "type": "array",
            "description": "Несколько источников данных с разными шаблонами",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "Путь к файлу"
                },
                "path": {
                  "type": "string",
                  "description": "Путь к списку в файле"
                },
                "commandTemplate": {
                  "type": "string",
                  "description": "Шаблон команды для этого источника"
                },
                "nameTemplate": {
                  "type": "string",
                  "description": "Шаблон имени для этого источника"
                }
              }
            }
          },
          "commandTemplate": {
            "type": "string",
            "description": "Шаблон команды (${key} заменяется на ключ из source)"
          },
          "stopCommandTemplate": {
            "type": "string",
            "description": "Шаблон команды остановки при закрытии терминала (${key})"
          },
          "nameTemplate": {
            "type": "string",
            "description": "Шаблон имени терминала"
          },
          "group": {
            "type": "string",
            "description": "Группа терминалов для управления"
          },
          "delay": {
            "type": "number",
            "description": "Задержка между запусками (мс)",
            "default": 300
          },
          "hideControlTerminal": {
            "type": "boolean",
            "description": "Скрыть управляющий терминал после запуска дочерних терминалов",
            "default": false
          }
        }
      },
      {
        "type": "ergo-module",
        "required": [
          "label",
          "detail",
          "command"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Имя задачи в Run Task"
          },
          "detail": {
            "type": "string",
            "description": "Краткое описание на русском"
          },
          "command": {
            "type": "string",
            "description": "Команда ergoms …"
          },
          "module": {
            "type": "string",
            "description": "Имя каталога модуля"
          },
          "panel": {
            "type": "string",
            "description": "Панель терминала: shared или new",
            "enum": [
              "shared",
              "new"
            ],
            "default": "shared"
          }
        }
      }
    ]
  }
}
