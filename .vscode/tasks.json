        {
            "label": "Logs: All services",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Logs: ergo-api-dev",
                "Logs: ergo-client-dev",
                "Logs: ergo-celery-worker",
                "Logs: ergo-celery-beat"
            ],
            "problemMatcher": []
        },
        {
            "label": "Logs: ergo-api-dev",
            "type": "shell",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-Command"]
                }
            },
            "command": "Get-Content -Path \"$env:ProgramData\\ergo_ms\\logs\\ergo-api-dev.log\" -Wait -Tail 500",
            "windows": {
                "command": "Get-Content -Path \"$env:ProgramData\\ergo_ms\\logs\\ergo-api-dev.log\" -Wait -Tail 500",
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-Command"]
                    }
                }
            },
            "linux": {
                "command": "journalctl -u ergo-api-dev -n 500 -f | cat",
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-lc"]
                    }
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "ergo-api-dev",
                "clear": false
            },
            "isBackground": false,
            "problemMatcher": []
