            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Logs: All services",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Logs: ergo-api-dev",
                "Logs: ergo-client-dev",
                "Logs: ergo-celery-worker",
                "Logs: ergo-celery-beat"
            ],
            "problemMatcher": []
        },
        {
            "label": "Logs: ergo-api-dev",
            "type": "shell",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "command": "echo Logs not available on Windows - use Windows tasks instead",
            "windows": {
                "command": "echo Logs not available on Windows - use Windows tasks instead",
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            },
            "linux": {
                "command": "journalctl -u ergo-api-dev -n 500 -f | cat",
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-lc"]
                    }
                }
            },
            "presentation": {
                "reveal": "always",
