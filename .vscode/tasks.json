{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Celery Worker",
            "type": "multi-terminal",
            "source": {
                "file": "celery_workers.yaml",
                "path": "workers"
            },
            "commandTemplate": "ergoms start-worker --worker=${key}",
            "nameTemplate": "Celery Worker: ${key}",
            "group": "celery-workers",
            "delay": 500,
            "hideControlTerminal": true
        },
        {
            "label": "Setup Full System",
            "type": "multi-terminal",
            "terminals": [
                {
                    "name": "Install ErgoMS CLI",
                    "command": "if [ -f \"core/deployment/linux/ergo_ms.sh\" ]; then sudo bash core/deployment/linux/ergo_ms.sh install-cli; elif [ -f \"core/deployment/windows/ergo_ms.ps1\" ]; then powershell.exe -ExecutionPolicy Bypass -NoProfile -File core\\deployment\\windows\\ergo_ms.ps1 install-cli; fi"
                },
                {
                    "name": "Setup Full",
                    "command": "if [ -f \"core/deployment/linux/ergo_ms.sh\" ]; then sudo ergoms setup-full; elif [ -f \"core/deployment/windows/ergo_ms.ps1\" ]; then ergoms setup-full; fi"
                }
            ],
            "group": "setup",
            "delay": 2000,
            "hideControlTerminal": true,
            "problemMatcher": []
        },
        {
            "label": "Update Submodules",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "command": "ergoms update-submodules --root \"${workspaceFolder}\"",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                },
                "command": "ergoms update-submodules --root \"${workspaceFolder}\""
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-lc"
                        ]
                    }
                },
                "command": "ergoms update-submodules --root \"${workspaceFolder}\""
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "group": {
                "kind": "build"
            },
            "problemMatcher": []
        },
        {
            "label": "Start All Services",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Client",
                "API",
                "Celery Worker",
                "Celery Beat",
                "Ollama"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Client",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "command": "ergoms start-client",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                },
                "command": "ergoms start-client"
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-lc"
                        ]
                    }
                },
                "command": "ergoms start-client"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "API",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "command": "ergoms dev",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                },
                "command": "ergoms dev"
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-lc"
                        ]
                    }
                },
                "command": "ergoms dev"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Celery Beat",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "command": "ergoms start-beat",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                },
                "command": "ergoms start-beat"
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-lc"
                        ]
                    }
                },
                "command": "ergoms start-beat"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Ollama",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "command": "ergoms ollama",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                },
                "command": "ergoms ollama"
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": [
                            "-lc"
                        ]
                    }
                },
                "command": "ergoms ollama"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Logs: All Services",
            "type": "multi-terminal",
            "sources": [
                {
                    "file": ".vscode/logs-services.yaml",
                    "path": "services",
                    "commandTemplate": "ergoms logs ${key} 500",
                    "nameTemplate": "Logs: ${key}"
                },
                {
                    "file": "celery_workers.yaml",
                    "path": "workers",
                    "commandTemplate": "ergoms logs ergo-celery-worker-${key} 500",
                    "nameTemplate": "Logs: Celery Worker-${key}"
                }
            ],
            "group": "logs",
            "delay": 300,
            "hideControlTerminal": true,
            "problemMatcher": []
        },
    ]
}
