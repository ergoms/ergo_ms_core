                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Install Video Analysis Dependencies",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/api",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "command": ".venv\\Scripts\\activate.bat && api install_ffmpeg && api install_opus_mt && api install_vosk_model && api install_silero_repo && api install_tts_model --language fr --speaker v3_fr",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}/api",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
