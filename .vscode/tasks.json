{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Full System",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "command": "cd /d \"${workspaceFolder}\\api\" && py -3.12 -m venv .venv && .venv\\Scripts\\activate.bat && pip install poetry && poetry install && api migrate && api collectstatic --noinput && cd /d \"${workspaceFolder}\\client\" && npm install",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                },
                "command": "cd /d \"${workspaceFolder}\\api\" && py -3.12 -m venv .venv && .venv\\Scripts\\activate.bat && pip install poetry && poetry install && api migrate && api collectstatic --noinput && cd /d \"${workspaceFolder}\\client\" && npm install"
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-lc"]
                    }
                },
                "command": "cd \"${workspaceFolder}/api\" && python3.12 -m venv .venv && source .venv/bin/activate && pip install poetry && poetry install && api migrate && api collectstatic --noinput && sudo /bin/bash \"${workspaceFolder}/linux/ergo_ms.sh\" install \"${workspaceFolder}\" && cd \"${workspaceFolder}/client\" && npm install"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "group": {
                "kind": "build"
            },
            "problemMatcher": []
        },
        {
            "label": "Start All Services",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Client",
                "API",
                "Celery Worker",
                "Celery Beat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Client",
            "type": "shell",
            "command": "npm",
            "args": ["run", "dev"],
            "options": {
                "cwd": "${workspaceFolder}/client"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "API",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/api",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "command": ".venv\\Scripts\\activate.bat && api dev",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}/api",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                },
                "command": ".venv\\Scripts\\activate.bat && api dev"
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}/api",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-lc"]
                    }
                },
                "command": "source .venv/bin/activate && api dev"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Celery Worker",
            "type": "shell",
