{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Celery Worker",
            "type": "multi-terminal",
            "source": {
                "file": "celery_workers.yaml",
                "path": "workers"
            },
            "commandTemplate": "ergoms start-worker --worker=${key}",
            "nameTemplate": "Celery Worker: ${key}",
            "group": "celery-workers",
            "delay": 500,
            "hideControlTerminal": true
        },
        {
            "label": "Setup Full System",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"core/deployment/windows/ergo_ms.ps1\" setup-full && npm run install-extensions",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                }
            },
            "linux": {
                "options": {
                    "shell": { "executable": "/bin/bash", "args": ["-lc"] }
                },
                "command": "sudo bash core/deployment/linux/ergo_ms.sh setup-full && npm run install-extensions"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "group": { "kind": "build", "isDefault": false },
            "problemMatcher": []
        },
        {
            "label": "Update Submodules",
            "type": "shell",
            "command": "ergoms update-submodules",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "group": { "kind": "build" },
            "problemMatcher": []
        },
        {
            "label": "Cache Warmup",
            "type": "shell",
            "command": "ergoms warmup-caches-if-needed",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                }
            },
            "linux": {
                "options": {
                    "shell": { "executable": "/bin/bash", "args": ["-lc"] }
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Services",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Client",
                "API",
                "Media API",
                "Celery Worker",
                "Celery Beat"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Start All Services",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Cache Warmup",
                "Services"
            ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Client",
            "type": "shell",
            "command": "ergoms start-client",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                }
            },
            "linux": {
                "options": {
                    "shell": { "executable": "/bin/bash", "args": ["-lc"] }
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "API",
            "type": "shell",
            "command": "ergoms dev",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                }
            },
            "linux": {
                "options": {
                    "shell": { "executable": "/bin/bash", "args": ["-lc"] }
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Media API",
            "type": "shell",
            "command": "ergoms start-media",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                }
            },
            "linux": {
                "options": {
                    "shell": { "executable": "/bin/bash", "args": ["-lc"] }
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Celery Beat",
            "type": "shell",
            "command": "ergoms start-beat",
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                }
            },
            "linux": {
                "options": {
                    "shell": { "executable": "/bin/bash", "args": ["-lc"] }
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Logs: All Services",
            "type": "multi-terminal",
            "sources": [
                {
                    "file": ".vscode/logs-services.yaml",
                    "path": "services",
                    "commandTemplate": "ergoms logs ${key} 500",
                    "nameTemplate": "Logs: ${key}"
                },
                {
                    "file": "celery_workers.yaml",
                    "path": "workers",
                    "commandTemplate": "ergoms logs ergo-celery-worker-${key} 500",
                    "nameTemplate": "Logs: Celery Worker-${key}"
                }
            ],
            "group": "logs",
            "delay": 300,
            "hideControlTerminal": true,
            "problemMatcher": []
        }
    ]
}
