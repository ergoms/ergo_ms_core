{
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "args": ["-NoExit", "-Command", "& { if (Test-Path '${workspaceFolder}\\virtual_env\\python\\Scripts\\Activate.ps1') { & '${workspaceFolder}\\virtual_env\\python\\Scripts\\Activate.ps1' } }"]
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": ["/k", "${workspaceFolder}\\virtual_env\\python\\Scripts\\activate.bat"],
            "icon": "terminal-cmd"
        }
    },
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash",
            "args": ["-c", "source ${workspaceFolder}/virtual_env/python/bin/activate && exec bash"]
        },
        "zsh": {
            "path": "/bin/zsh",
            "icon": "terminal-bash",
            "args": ["-c", "source ${workspaceFolder}/virtual_env/python/bin/activate && exec zsh"]
        }
    },
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.focusMode": "singleClick",
    "terminal.integrated.tabs.showActions": "always",
    "terminal.integrated.tabs.title": "${processName}",
    "terminal.integrated.tabs.description": "${cwd}",
    "terminal.integrated.splitCwd": "workspaceRoot",
    
    "files.exclude": {
        "**/.git": false,
        "**/.DS_Store": true,
        "**/.*": false
    },
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/virtual_env": true
    },

    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "tsconfig.json": "tsconfig.*.json, env.d.ts",
      "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
      "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .prettier*, prettier*, .editorconfig, .npmrc",
      "pyproject.toml": "poetry.lock"
    },
    "python.defaultInterpreterPath": "${env:ERGO_PYTHON_INTERPRETER}",
    "terminal.integrated.env.linux": {
        "ERGO_PYTHON_INTERPRETER": "${workspaceFolder}/virtual_env/python/bin/python3.12"
    },
    "terminal.integrated.env.windows": {
        "ERGO_PYTHON_INTERPRETER": "${workspaceFolder}\\virtual_env\\python\\Scripts\\python.exe"
    },
    "python.terminal.activateEnvironment": true
}