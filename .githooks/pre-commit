#!/bin/sh
# Проверяет, что копии правил Cursor для Claude Code и Codex актуальны.
# Включение: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 1
python3 "$root/.claude/scripts/sync_claude_rules.py" --check || exit 1
python3 -B "$root/.codex/scripts/sync_codex_rules.py" --check
