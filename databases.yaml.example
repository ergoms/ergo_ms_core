databases:
  default:
    engine: "postgresql"
    name: "ergo_ms"
    user: "postgres"
    password: "admin"
    host: "localhost"
    # 5433 — portable (ergoms install-postgres / setup-full); host/port — источник для listen portable
    # 5432 — системный Postgres, если используете его вместо portable
    port: 5433

  celery:
    engine: "postgresql"
    name: "ergo_ms_celery"
    user: "celery_user"
    password: "celery_password"
    host: "localhost"
    port: 5433
  
  celery_worker:
    engine: "postgresql"
    name: "ergo_ms_celery_worker"
    user: "celery_worker_user"
    password: "worker_password"
    host: "localhost"
    port: 5433
  
  celery_beat:
    engine: "postgresql"
    name: "ergo_ms_celery_beat"
    user: "celery_beat_user"
    password: "beat_password"
    host: "localhost"
    port: 5433

  analytics:
    engine: "mysql"
    name: "world"
    user: "root"
    password: "admin"
    host: "localhost"
    port: 3306
