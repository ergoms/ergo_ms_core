# Каталог подключений. Режим default задаётся ERGO_DB в .env
# (sqlite | postgres | portable_postgres | mysql | mssql) — loader выставляет engine.
# Host/user/password/port/name для SQL — здесь. Redis — секция redis (не в .env).
databases:
  default:
    engine: "postgresql"
    name: "ergo_ms"
    user: "postgres"
    password: "admin"
    host: "127.0.0.1"
    # 5433 — portable (ERGO_DB=portable_postgres / ergoms install-postgres);
    # 5432 — системный Postgres; MySQL обычно 3306; MSSQL — 1433
    port: 5433

  celery:
    engine: "postgresql"
    name: "ergo_ms_celery"
    user: "celery_user"
    password: "celery_password"
    host: "127.0.0.1"
    port: 5433

  celery_worker:
    engine: "postgresql"
    name: "ergo_ms_celery_worker"
    user: "celery_worker_user"
    password: "worker_password"
    host: "127.0.0.1"
    port: 5433

  celery_beat:
    engine: "postgresql"
    name: "ergo_ms_celery_beat"
    user: "celery_beat_user"
    password: "beat_password"
    host: "127.0.0.1"
    port: 5433

  analytics:
    engine: "mysql"
    name: "world"
    user: "root"
    password: "admin"
    host: "127.0.0.1"
    port: 3306

  # При ERGO_BROKER=redis — кэш, channel layer и Celery.
  # В Docker host обычно remapped на имя сервиса (DOCKER_SERVICE_REDIS).
  redis:
    engine: "redis"
    host: "127.0.0.1"
    port: 6379
    db_channel: 0
    db_cache: 1
    db_celery_broker: 2
    db_celery_result: 3
