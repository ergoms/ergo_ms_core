# =============================================================================
# КОНФИГУРАЦИЯ БАЗ ДАННЫХ
# =============================================================================
# Этот файл содержит настройки подключения к различным базам данных системы.
# Скопируйте этот файл в databases.yaml и заполните реальными значениями.
# =============================================================================

databases:
  # ---------------------------------------------------------------------------
  # Основная база данных (default)
  # ---------------------------------------------------------------------------
  # Используется для хранения основной информации системы, пользователей,
  # модулей CMS и других базовых данных приложения
  default:
    engine: "postgresql"
    name: "ergo_ms"
    user: "postgres"
    password: "admin"
    host: "localhost"
    port: 5432

  # ---------------------------------------------------------------------------
  # База данных для Celery (очередь задач)
  # ---------------------------------------------------------------------------
  # Используется Celery для хранения метаданных о задачах, результатах
  # и состоянии очереди асинхронных задач
  #
  # ВАЖНО: ЛОГИКА РАБОТЫ С БД ДЛЯ CELERY
  # ---------------------------------------------------------------------------
  # Система Celery использует приоритетную систему выбора конфигурации:
  #
  # CELERY WORKER (брокер и результаты):
  #   1. Сначала ищет секцию 'celery_worker'
  #   2. Если нет, ищет общую секцию 'celery'
  #   3. Если ничего нет - использует локальный SQLite
  #
  # CELERY BEAT (брокер):
  #   1. Сначала ищет общую секцию 'celery' (чтобы использовать тот же брокер, что и Worker)
  #   2. Если нет общей, ищет 'celery_worker' (чтобы совпадало с Worker)
  #   3. Если нет, ищет 'celery_beat'
  #   4. Если ничего нет - использует локальный SQLite
  #
  # CELERY BEAT (расписание):
  #   1. Сначала ищет секцию 'celery_beat' (отдельная БД для расписания)
  #   2. Если нет, ищет общую секцию 'celery'
  #   3. Если ничего нет - использует локальный SQLite файл
  #
  # ВАРИАНТЫ НАСТРОЙКИ:
  # ---------------------------------------------------------------------------
  # Вариант 1 (РЕКОМЕНДУЕТСЯ): Общая БД для всех компонентов
  #   - Создайте только секцию 'celery'
  #   - Worker и Beat будут использовать одну БД для брокера
  #   - Расписание также будет храниться в этой БД
  #
  # Вариант 2: Отдельные БД для Worker и Beat
  #   - Создайте секции 'celery_worker' и 'celery_beat'
  #   - Worker использует 'celery_worker' для брокера
  #   - Beat использует 'celery_worker' для брокера (чтобы задачи доходили до Worker)
  #   - Beat использует 'celery_beat' для хранения расписания
  #
  # Вариант 3: Локальный SQLite
  #   - Не создавайте секций или установите CELERY_USE_LOCAL=true
  #   - Все данные будут храниться в локальных файлах
  #
  # ВАРИАНТЫ НАСТРОЙКИ ПОЛЬЗОВАТЕЛЕЙ:
  # ---------------------------------------------------------------------------
  # Вариант 1 (РЕКОМЕНДУЕТСЯ для разработки):
  #   Использовать одного пользователя для всех компонентов Celery.
  #   Например, можно использовать существующего пользователя 'postgres':
  #     user: "postgres"
  #     password: "ваш_пароль_postgres"
  #   Это упрощает настройку и не требует создания дополнительных пользователей.
  #
  # Вариант 2 (РЕКОМЕНДУЕТСЯ для продакшена):
  #   Создать отдельных пользователей для каждого компонента:
  #   - celery_user - для общей очереди задач
  #   - celery_worker_user - для воркеров
  #   - celery_beat_user - для планировщика
  #   Это обеспечивает лучшую изоляцию и безопасность.
  #
  # СОЗДАНИЕ ПОЛЬЗОВАТЕЛЕЙ В POSTGRESQL:
  # ---------------------------------------------------------------------------
  # Если вы выбрали вариант 2, создайте пользователей в PostgreSQL:
  #   CREATE USER celery_user WITH PASSWORD 'celery_password';
  #   CREATE USER celery_worker_user WITH PASSWORD 'worker_password';
  #   CREATE USER celery_beat_user WITH PASSWORD 'beat_password';
  #
  #   Создайте базы данных:
  #   CREATE DATABASE ergo_ms_celery OWNER celery_user;
  #   CREATE DATABASE ergo_ms_celery_worker OWNER celery_worker_user;
  #   CREATE DATABASE ergo_ms_celery_beat OWNER celery_beat_user;
  #
  #   Предоставьте права:
  #   GRANT ALL PRIVILEGES ON DATABASE ergo_ms_celery TO celery_user;
  #   GRANT ALL PRIVILEGES ON DATABASE ergo_ms_celery_worker TO celery_worker_user;
  #   GRANT ALL PRIVILEGES ON DATABASE ergo_ms_celery_beat TO celery_beat_user;
  #
  # ЕСЛИ ПОЛЬЗОВАТЕЛИ НЕ СОЗДАНЫ:
  # ---------------------------------------------------------------------------
  # Если указанные пользователи не существуют в PostgreSQL, система выдаст
  # ошибку аутентификации. В этом случае:
  # 1. Либо создайте пользователей (см. выше)
  # 2. Либо используйте существующего пользователя (например, 'postgres')
  # 3. Либо установите переменную окружения CELERY_USE_LOCAL=true для
  #    использования локального SQLite (данные будут храниться в файлах)
  # ---------------------------------------------------------------------------
  celery:
    engine: "postgresql"
    name: "ergo_ms_celery"
    user: "celery_user"  # Можно заменить на "postgres" для упрощения
    password: "celery_password"  # Укажите реальный пароль
    host: "localhost"
    port: 5432
  
  # ---------------------------------------------------------------------------
  # База данных для Celery Worker
  # ---------------------------------------------------------------------------
  # Используется воркерами Celery для хранения состояния выполнения задач
  # и промежуточных результатов (брокер и результаты)
  #
  # ПРИОРИТЕТ: celery_worker -> celery -> локальный SQLite
  # Если эта секция не найдена, система попытается использовать секцию 'celery',
  # а если и её нет - переключится на локальный SQLite
  #
  # ВАЖНО: Если вы создаете эту секцию, Beat также будет использовать её
  # для брокера (если нет общей секции 'celery'), чтобы задачи доходили до Worker
  #
  # МОЖНО ИСПОЛЬЗОВАТЬ ТОГО ЖЕ ПОЛЬЗОВАТЕЛЯ, ЧТО И В СЕКЦИИ 'celery':
  #   user: "celery_user"  # или "postgres" для упрощения
  #   password: "celery_password"  # тот же пароль
  celery_worker:
    engine: "postgresql"
    name: "ergo_ms_celery_worker"
    user: "celery_worker_user"  # Можно заменить на "celery_user" или "postgres"
    password: "worker_password"  # Укажите реальный пароль
    host: "localhost"
    port: 5432
  
  # ---------------------------------------------------------------------------
  # База данных для Celery Beat (планировщик задач)
  # ---------------------------------------------------------------------------
  # Используется Celery Beat для хранения расписания периодических задач
  # и информации о выполнении запланированных операций
  #
  # ВАЖНО: Эта секция используется ТОЛЬКО для хранения расписания!
  # Брокер для Beat выбирается по приоритету: celery -> celery_worker -> celery_beat
  # Это гарантирует, что Beat и Worker используют один брокер для обмена задачами
  #
  # ПРИОРИТЕТ ДЛЯ РАСПИСАНИЯ: celery_beat -> celery -> локальный SQLite
  # Если эта секция не найдена, система попытается использовать секцию 'celery',
  # а если и её нет - переключится на локальный SQLite файл
  #
  # МОЖНО ИСПОЛЬЗОВАТЬ ТОГО ЖЕ ПОЛЬЗОВАТЕЛЯ, ЧТО И В СЕКЦИИ 'celery':
  #   user: "celery_user"  # или "postgres" для упрощения
  #   password: "celery_password"  # тот же пароль
  #
  # ВАЖНО: Если указанный пользователь не существует в PostgreSQL, Celery Beat
  # не сможет запуститься и выдаст ошибку аутентификации. В этом случае:
  # 1. Создайте пользователя в PostgreSQL (см. комментарии к секции 'celery')
  # 2. Или используйте существующего пользователя (например, 'postgres')
  # 3. Или установите CELERY_USE_LOCAL=true для использования локального SQLite
  celery_beat:
    engine: "postgresql"
    name: "ergo_ms_celery_beat"
    user: "celery_beat_user"  # Можно заменить на "celery_user" или "postgres"
    password: "beat_password"  # Укажите реальный пароль
    host: "localhost"
    port: 5432

  # ---------------------------------------------------------------------------
  # Пример дополнительной базы данных (их можно подключать множество)
  # ---------------------------------------------------------------------------
  analytics:
    engine: "mysql"
    name: "world"
    user: "root"
    password: "admin"
    host: "localhost"
    port: 3306