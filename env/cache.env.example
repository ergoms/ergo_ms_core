# Фрагмент кэша Django. Копия: copy env/cache.env.example env/cache.env
# При ERGO_BROKER=redis можно поставить API_CACHE_BACKEND=redis (или оставить auto-выбор в коде).

# Где хранить кэш API: locmem (память процесса) | file | redis | dummy (выкл.)
API_CACHE_BACKEND=locmem
# Свой URL Redis для кэша (иначе — секция redis в databases.yaml)
# API_CACHE_REDIS_URL=redis://127.0.0.1:6379/1

# Срок жизни кэша по умолчанию, сек
API_CACHE_DEFAULT_TIMEOUT=300
# Как часто обновлять кэш меню боковой панели, сек
API_MENU_CACHE_TTL=300
# Как часто обновлять снимок прав пользователя, сек
API_PERMISSIONS_SNAPSHOT_CACHE_TTL=60
# Как часто обновлять счётчик непрочитанных уведомлений, сек
API_NOTIFICATIONS_UNREAD_CACHE_TTL=45
