# Фрагмент модулей, ModuleBridge и модульности клиента.
# Копия: copy env/modules.env.example env/modules.env
# MODULE_RUNTIME / CLIENT_MODULARITY задаются в корневом .env.

# --- Клиент: allow-list и federation ---
# CSV модулей в бандл (пусто = все кроме DISABLED_MODULES). Для bundled и federated host.
CLIENT_MODULES=
# federated: <name>=https://cdn.example/<name>/remoteEntry.js,<other>=https://…
CLIENT_MODULE_REMOTES=
# Shared для Module Federation (через запятую)
CLIENT_FEDERATION_SHARED=vue,vue-router,pinia

# --- Список вынесенных API-модулей (только при MODULE_RUNTIME=microservice) ---
# CSV имён папок modules/<name>
MICROSERVICE_MODULES=

# Роль процесса: api | module:<name> | (пусто для worker/beat — все модули)
# ERGO_PROCESS_ROLE=api
# Явный allow-list modules.* для процесса (перекрывает фильтр MICROSERVICE_MODULES)
# PROCESS_MODULES=

# Порт/хост модуля на машине (<NAME> = имя модуля в UPPERCASE + _PORT / _HOST)
# <NAME>_PORT=8123
# <NAME>_HOST=127.0.0.1

# --- ModuleBridge ---
# Транспорт ops: local (монолит) | http (RPC между процессами)
BRIDGE_TRANSPORT=local
# Шина событий: local | redis (нужен Redis при microservice)
BRIDGE_EVENT_BUS=local
# Shared secret для /internal/bridge/* (заголовок X-Bridge-Token).
# Мост принимает запрос только с loopback (монолит) или private/link-local
# (MODULE_RUNTIME=microservice|split). Nginx режет /internal/ снаружи.
# При MODULE_RUNTIME=microservice пусто — setup-full и запуск служб запишут.
# Вручную: ergoms generate-secret
BRIDGE_INTERNAL_TOKEN=
# Карта URL сервисов: <name>=http://127.0.0.1:8123
BRIDGE_SERVICE_URLS=
# URL ядра для обратных вызовов из module-процессов
BRIDGE_CORE_URL=
# Таймаут HTTP bridge (сек)
BRIDGE_HTTP_TIMEOUT=10
# Повторы HTTP-моста при 5xx / сетевой ошибке (4xx не повторяем)
BRIDGE_HTTP_RETRIES=2
# Лимит служебного /internal/bridge/* (count/period)
BRIDGE_INTERNAL_RATE=60/minute
# Redis DB для bridge EventBus
BRIDGE_REDIS_DB=4

# Изоляция модулей: off | warn | raise
BRIDGE_ISOLATION=warn
# Проверка схем дескрипторов моста: off | warn | raise
BRIDGE_CONTRACTS=warn
# Вход на процессе модуля: orm (читает auth_user) | jwt_claims (уровень 3, principal из JWT)
MODULE_AUTH_MODE=orm

# --- Standalone SPA (CLIENT_MODULARITY=standalone) ---
# CORS: добавьте origin'ы SPA в корневой CORS_ALLOWED_ORIGINS
# Пример: https://spa-a.example.com,https://spa-b.example.com
# nginx: отдельные server_name / root на каждый dist модуля; /api/ → общий gateway
