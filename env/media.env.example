# Фрагмент Media API. Копия: copy env/media.env.example env/media.env
# Режим доступа core/api → файлы: ERGO_MEDIA=local|remote в корневом .env
# (явный MEDIA_ACCESS_MODE перекрывает ERGO_MEDIA, если задан).

# CDN для /serve/ и /upload/ (подписанные URL). Dev: http://localhost:BIND_PORT без MEDIA_API_URL.
MEDIA_API_BIND_HOST=127.0.0.1
MEDIA_API_BIND_PORT=8003
# Режим берётся из ERGO_ENV; явный override:
# MEDIA_API_DEPLOY_TYPE=development

# Публичный хост media_api за nginx (если MEDIA_API_URL не задан; при доступе по IP оставьте пустым):
# MEDIA_API_HOST=app.example.com
# MEDIA_API_PORT=443
# MEDIA_API_PROTOCOL=https
# MEDIA_API_URL=https://app.example.com
# MEDIA_API_ALLOWED_HOSTS=app.example.com

# Редирект HTTP → HTTPS в Django media_api (true только если TLS на самом процессе, не за nginx):
# MEDIA_API_SECURE_SSL_REDIRECT=false

# Нестандартный путь к файлам (по умолчанию <корень_проекта>/media):
# MEDIA_STORAGE_PATH=/data/media

# При ERGO_MEDIA=remote (или MEDIA_ACCESS_MODE=remote):
# MEDIA_API_INTERNAL_KEY=          # openssl rand -hex 32, одинаково на обоих
# MEDIA_API_INTERNAL_URL=http://10.0.0.5:8003
#
# Доверенные прокси для X-Forwarded-For (IP или CIDR через запятую).
# Пустой список (по умолчанию) — XFF игнорируется, клиентский IP = REMOTE_ADDR.
# Задавайте только если media_api стоит за reverse proxy и internal/health
# должны видеть реальный клиентский IP из XFF:
# MEDIA_API_TRUSTED_PROXIES=10.0.0.1,10.0.0.0/8

# Дефолтный потолок media_api (байты), если модуль не запросил свой max_size.
# MEDIA_UPLOAD_MAX_SIZE=524288000
#
# Абсолютный потолок (байты). Модуль может запросить выше MEDIA_UPLOAD_MAX_SIZE
# (например модуль с CLIENT_VIDEO_UPLOAD_MAX_SIZE_MB=0), но не выше hard.
# Учитывается в nginx client_max_body_size. По умолчанию 5 ГиБ.
# MEDIA_UPLOAD_HARD_MAX_SIZE=5368709120
#
# Vite: CLIENT_MEDIA_UPLOAD_MAX_SIZE / CLIENT_MEDIA_UPLOAD_HARD_MAX_SIZE.
# Проверка: ergoms upload-limits-check
#
# Время жизни upload-токена, секунды (для больших файлов можно увеличить):
# MEDIA_UPLOAD_TOKEN_EXPIRATION=900
# TTL подписанных URL раздачи файлов, секунды (дефолт кода 3600)
# MEDIA_URL_EXPIRATION=3600
# Лимит частоты загрузок media_api (дефолт кода 30/minute)
# MEDIA_API_UPLOAD_RATE=30/minute
#
# Проверка содержимого загрузок (Upload + InternalWrite):
# extension | extension_and_magic | extension_magic_av
# Дефолт кода — extension; профиль ERGO_SECURITY=hardened → extension_and_magic
# MEDIA_API_CONTENT_VALIDATION=extension
