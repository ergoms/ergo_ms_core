# Фрагмент Celery. Копия: copy env/celery.env.example env/celery.env
# Очередь по умолчанию следует ERGO_BROKER (auto).

# Очередь задач: auto (из ERGO_BROKER) | redis | database | local (SQLite)
CELERY_BROKER_BACKEND=auto
# Свои URL брокера и результатов (иначе — databases.yaml)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
