# Поиск (Meilisearch / BM25)
# Скопируйте в .env и настройте под среду.

# Включить централизованный поиск (fallback на icontains/trigram при false или недоступности Meili)
ERGO_SEARCH_ENABLED=true

# URL Meilisearch для API (в Docker — http://meilisearch:7700)
# Хост: 8004 — следующий свободный после API/client/jupyter/media
MEILI_HOST=http://127.0.0.1:8004
MEILI_HTTP_ADDR=127.0.0.1:8004

# Master key (обязателен в production; не попадает в клиент)
MEILI_MASTER_KEY=ergo_ms_dev_meili_key

# Docker Compose (опционально; внутри сети контейнер слушает 7700).
# Публикация на хост — DOCKER_MEILI_PUBLISH_PORT в env/docker.env (пусто = auto по MEILI_HTTP_ADDR).
# DOCKER_MEILI_IMAGE=getmeili/meilisearch:v1.12
